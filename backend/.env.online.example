PORT=4000
DATABASE_MODE=supabase-online
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-hosted-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-hosted-service-role-or-secret-key
# Signs the browser's one-hour pass for live features (Supabase Realtime). Keep it secret.
# Hosted: Supabase dashboard > Project Settings > JWT Keys > Legacy JWT secret.
SUPABASE_JWT_SECRET=your-hosted-legacy-jwt-secret
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
LOCAL_JAVA_EXECUTION=true
JUDGE0_URL=
JUDGE0_API_KEY=
