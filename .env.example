# Only for the Vercel + Render setup: the address of the separate Render server.
# Leave it unset for offline mode, `npm run dev`, and Cloudflare, where the pages use
# their own /api routes (app/api/[...path]/route.ts).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live features get the Supabase URL and public key from the server
# (GET /api/realtime/pass), so no NEXT_PUBLIC_SUPABASE_* values are needed.
