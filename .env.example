# Local frontend override. `npm run dev` detects the teacher laptop LAN address automatically.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live features get the Supabase URL and public key from the backend
# (GET /api/realtime/pass), so no NEXT_PUBLIC_SUPABASE_* values are needed.
